# Copy this file to .env (in this hw5/ folder) and fill in your own key.
# .env is in .gitignore: never commit your real key.

# Class Portkey key (used by every agent through the OpenAI Responses API)
PORTKEY_API_KEY=your-portkey-api-key-here

# Desk signing (the dashboard's Sign / Decline / Reset buttons need this PIN).
# Leave it empty and every approval is refused. Pick your own; never commit .env.
DESK_APPROVAL_PIN=change-me
# Optional: only these people may sign (comma separated). Empty = any human name.
DESK_APPROVERS=
# Payments or purchases above this many dollars need two different approvers.
SECOND_APPROVER_ABOVE=5000

# Optional overrides
MODEL_NAME=gpt-6-astra
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: point the React desk at a different backend (frontend reads VITE_* vars)
# VITE_API_URL=http://localhost:8000
