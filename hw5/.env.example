# Copy this file to .env (in this hw5/ folder) and fill in your own key.
# .env is in .gitignore: never commit your real key.

# Class Portkey key (used by every agent through the OpenAI Responses API)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides
MODEL_NAME=gpt-6-astra
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: point the React desk at a different backend (frontend reads VITE_* vars)
# VITE_API_URL=http://localhost:8000
